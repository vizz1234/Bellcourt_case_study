# Bellcourt Health Administrators - Environment Variables
# Copy this file to .env and configure your keys

# OpenRouter API Key for LLM Clinical Guardrails & Agentic RAG
OPEN_ROUTER_API_KEY=your_open_router_api_key_here

# LLM Model for Security Guardrails (cost-effective, low-latency)
LLM_GUARDRAIL_MODEL=openai/gpt-4o-mini
